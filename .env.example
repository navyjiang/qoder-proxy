# Copy this file to .env for local use only.
# Do not commit .env or share its contents.

PORT=3000
PROXY_API_KEY=

# Backend: "global" (qoder.com) or "cn" (qoder.com.cn)
# Auth uses the CLI's own login state (~/.qoder or ~/.qoderworkcn) —
# run `qodercli login` (or `qoderclicn login`) once; no token needed here.
CLI_BACKEND=global

# Defaults applied when the request doesn't specify them
QODERCN_REASONING_EFFORT=
QODERCN_CONTEXT_WINDOW=
QODERCN_MAX_OUTPUT_TOKENS=
QODERCN_TIMEOUT_MS=600000

# Force a specific reasoning effort, overriding whatever the client sends.
# Useful when the client (e.g. Claude Code) clamps the requested effort to a
# lower value for non-Anthropic models. Valid values: low, medium, high, xhigh, max.
# Leave empty to respect the client's requested effort.
QODERCN_FORCE_EFFORT=

# Max HTTP request body size (clients that resend full chat history need >1mb)
QODERCN_BODY_LIMIT=25mb
